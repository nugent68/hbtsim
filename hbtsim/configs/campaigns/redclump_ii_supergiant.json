{
  "schema_version": 1,
  "kind": "campaign",
  "name": "redclump_ii_supergiant",
  "label": "Red-clump scale precision (Kim & Kaiser comparison) with the 5000 K / log g 0 supergiant stand-in",
  "runner": "scale",
  "targets": [
    "hd17652",
    "hd360"
  ],
  "instrument": {
    "telescope": "kk_4m"
  },
  "backends": [
    "kk_1000ch",
    "spad320_timetag",
    "spad320_correlator",
    "r5000_correlator",
    "r5000_correlator_pbs"
  ],
  "atmosphere": {
    "use": true,
    "stand_in": "lte05000-0.00-0.0",
    "resource": "newera_redclump"
  },
  "options": {
    "hours": 2.0,
    "filters": [
      "filter_johnson_v",
      "filter_cousins_r",
      "filter_cousins_i",
      "filter_2mass_h",
      "filter_2mass_k"
    ],
    "baseline_scan_m": {
      "start": 20.0,
      "stop": 300.0,
      "step": 5.0
    },
    "target_sigma_s": 0.007,
    "eonsii_case": {
      "telescope": "eonsii_4m",
      "backend": "eonsii_spad"
    }
  },
  "outputs": {
    "figures": true
  }
}
